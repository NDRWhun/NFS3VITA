// Glide triangle vertex program.
// Positions arrive in Glide screen pixels with z = ooz (0..65535). The clip-space w is 1/oow, so the hardware
// interpolates the texture coordinates (and colours) perspective-correctly.

void main(
    float3 aPosition,
    float4 aColor,
    float2 aTexCoord,                       // sow, tow (0..256 over the texture, times oow)
    float3 aCombine,                        // x: colour factor, y: alpha factor, z: oow
    uniform float4 uViewport,               // x,y: NDC scale; z,w: NDC offset
    float4 out vPosition : POSITION,
    float2 out vTexCoord : TEXCOORD0,       // normalised texture coordinates
    half4  out vColor    : COLOR0,
    half4  out vFactor   : TEXCOORD1)       // combine factors (colour, colour, colour, alpha)
{
    float w = 1.0 / aCombine.z;
    vTexCoord = aTexCoord * (w * (1.0 / 256.0));
    vColor = aColor;
    vFactor = aCombine.xxxy;
    vPosition = float4(aPosition.x * uViewport.x + uViewport.z,
                       aPosition.y * uViewport.y + uViewport.w,
                       aPosition.z * (1.0 / 65536.0),
                       1.0) * w;
}
